# EXPERIMENTAL: build a native AArch64 probe for RetroDECK's Flatpak SDL2.
FROM --platform=linux/arm64 ubuntu:24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates build-essential libsdl2-dev \
 && rm -rf /var/lib/apt/lists/*

COPY sdl64-egl-probe.c /src/sdl64-egl-probe.c
RUN mkdir -p /out \
 && gcc \
      -I/usr/include/SDL2 \
      -L/usr/lib/aarch64-linux-gnu \
      -Wl,-rpath-link,/usr/lib/aarch64-linux-gnu \
      /src/sdl64-egl-probe.c -lSDL2 -o /out/sdl64-egl-probe \
 && readelf -h /out/sdl64-egl-probe | grep -q 'Machine:.*AArch64'

FROM scratch AS artifact
COPY --from=build /out/ /
